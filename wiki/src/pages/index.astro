---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, SITE, articlePath } from '../data/wiki';

const articles = (await getCollection('articles')).sort((a, b) => a.data.order - b.data.order);
const starters = ['riftborne-overview', 'opening-priorities', 'resources', 'fleet-composition']
  .map((slug) => articles.find((article) => article.data.slug === slug))
  .filter(Boolean);
const essential = ['combat-power', 'shield-integrity', 'objectives-and-victory', 'official-multiplayer', 'advanced-tactics-and-edge-cases']
  .map((slug) => articles.find((article) => article.data.slug === slug))
  .filter(Boolean);
const howTo = [
  ['Create or move a fleet', 'fleet-controls'],
  ['Found a colony or outpost', 'settlement-procedure'],
  ['Choose which ship to build', 'which-ship-should-i-build'],
  ['Understand organization shares', 'shares-and-share-pool'],
  ['Craft and install an SPU', 'spu-crafting-and-delivery'],
  ['Check a building prerequisite', 'buildings-and-base-roles']
].map(([label, slug]) => ({ label, article: articles.find((article) => article.data.slug === slug) })).filter((item) => item.article);
const troubleshooting = [
  ['I cannot colonize or establish an outpost', 'troubleshooting-colonization'],
  ['Ships disappeared or appeared in the wrong place', 'troubleshooting-fleets-and-ships'],
  ['Cargo is reserved or unavailable', 'marketplace-cargo-and-liquidity'],
  ['My Astra economy is collapsing', 'astra-upkeep-and-starvation'],
  ['I cannot find a prerequisite', 'buildings-and-base-roles']
].map(([label, slug]) => ({ label, article: articles.find((article) => article.data.slug === slug) })).filter((item) => item.article);
const majorSystems = ['organizations', 'rare-metals-and-spus', 'settlement-slots', 'ships-fleets-and-travel', 'directives', 'resources']
  .map((slug) => articles.find((article) => article.data.slug === slug)).filter(Boolean);
const recentlyReviewed = [...articles]
  .sort((a, b) => b.data.lastReviewed.localeCompare(a.data.lastReviewed) || b.data.order - a.data.order)
  .slice(0, 6);
---
<BaseLayout description={SITE.description} pageClass="home-page">
  <div class="home-wrap">
    <section class="wiki-intro">
      <div>
        <span class="eyebrow">Independent reference · Patch {SITE.patch}</span>
        <h1>Riftborne Wiki</h1>
        <p>Mechanics, formulas, strategy, and multiplayer knowledge organized as a searchable, patch-aware reference.</p>
      </div>
      <form class="portal-search" action="/search/" method="get" role="search">
        <label for="portal-query">Search {articles.length} articles</label>
        <div><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg><input id="portal-query" name="q" type="search" placeholder="Search ships, buildings, formulas, or tactics" /><button>Search</button></div>
      </form>
    </section>

    <section class="notice-bar" aria-label="Patch status">
      <strong>Current reference: patch {SITE.patch}</strong>
      <span>Installed build reviewed {SITE.reviewed}</span>
      <a href="/wiki/sources-and-confidence/">How verification works</a>
    </section>

    <section class="portal-section start-section">
      <div class="section-heading">
        <div><span>New commanders</span><h2>Start here</h2></div>
        <a href="/category/getting-started/">All beginner pages</a>
      </div>
      <ol class="start-list">
        {starters.map((article, index) => article && <li>
          <a href={articlePath(article.data)}>
            <small>{String(index + 1).padStart(2, '0')}</small>
            <div><strong>{article.data.title}</strong><span>{article.data.summary}</span></div>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></svg>
          </a>
        </li>)}
      </ol>
    </section>

    {howTo.length > 0 && <section class="portal-section task-section">
      <div class="section-heading"><div><span>Task index</span><h2>How do I…?</h2></div><a href="/a-z/">Browse every article</a></div>
      <ul class="task-links">
        {howTo.map((item) => item.article && <li><a href={articlePath(item.article.data)}><strong>{item.label}?</strong><span>{item.article.summary}</span></a></li>)}
      </ul>
    </section>}

    {majorSystems.length > 0 && <section class="portal-section">
      <div class="section-heading"><div><span>Reference map</span><h2>Major systems</h2></div></div>
      <ul class="system-index">
        {majorSystems.map((article) => article && <li><a href={articlePath(article.data)}><strong>{article.data.title}</strong><span>{article.data.category}</span><p>{article.data.summary}</p></a></li>)}
      </ul>
    </section>}

    <section class="portal-section">
      <div class="section-heading">
        <div><span>Browse the wiki</span><h2>Topics</h2></div>
        <a href="/a-z/">A–Z article index</a>
      </div>
      <div class="topic-grid">
        {CATEGORIES.map((category) => {
          const count = articles.filter((article) => article.data.category === category.name).length;
          return <a href={`/category/${category.slug}/`}>
            <span class="topic-symbol" aria-hidden="true">{category.name.slice(0, 1)}</span>
            <strong>{category.name}</strong>
            <p>{category.description}</p>
            <small>{count} {count === 1 ? 'article' : 'articles'}</small>
          </a>;
        })}
      </div>
    </section>

    <div class="portal-columns">
      <section class="portal-section compact">
        <div class="section-heading"><div><span>Core reference</span><h2>Frequently needed</h2></div></div>
        <ul class="link-index">
          {essential.map((article) => article && <li><a href={articlePath(article.data)}><strong>{article.data.title}</strong><span>{article.data.category}</span></a></li>)}
        </ul>
      </section>
      <section class="portal-section compact">
        <div class="section-heading"><div><span>Maintenance</span><h2>Recently reviewed</h2></div></div>
        <ul class="link-index">
          {recentlyReviewed.map((article) => <li><a href={articlePath(article.data)}><strong>{article.data.title}</strong><time datetime={article.data.lastReviewed}>{article.data.lastReviewed}</time></a></li>)}
        </ul>
      </section>
    </div>

    {troubleshooting.length > 0 && <section class="portal-section troubleshooting-section">
      <div class="section-heading"><div><span>Diagnostics</span><h2>Troubleshooting</h2></div></div>
      <ul class="link-index">
        {troubleshooting.map((item) => item.article && <li><a href={articlePath(item.article.data)}><strong>{item.label}</strong><span>Open guide</span></a></li>)}
      </ul>
    </section>}

    <section class="portal-section evidence-section">
      <div class="section-heading"><div><span>Patch and evidence</span><h2>Know what is verified</h2></div></div>
      <p>The reference edition targets patch {SITE.patch}, build <code>{SITE.build}</code>. Articles separate core rules, live-world observations, and strategy analysis, with sanitized evidence attached to individual claims.</p>
      <a href="/wiki/sources-and-confidence/">Read the evidence policy</a>
    </section>

    <section class="contribute-strip">
      <div><span>Curated on GitHub</span><h2>Found an error or missing interaction?</h2><p>Corrections are reviewed against the active Codex, installed patch data, and primary documentation.</p></div>
      <a href="/wiki/contributing-to-wiki/">Contribute evidence</a>
    </section>
  </div>
</BaseLayout>
